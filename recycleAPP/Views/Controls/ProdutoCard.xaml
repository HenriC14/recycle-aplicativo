<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="recycleAPP.Views.Controls.ProductCard">

    <Border StrokeShape="RoundRectangle 14"
            Stroke="#3FBF63"
            StrokeThickness="1"
            BackgroundColor="White"
            Padding="10">

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="4">

            <Image Source="{Binding ImagemUrl}"
                   Aspect="AspectFill"
                   HeightRequest="120"
                   WidthRequest="120"
                   HorizontalOptions="Center">
                <Image.Clip>
                    <RoundRectangleGeometry CornerRadius="10" Rect="0,0,110,110" />
                </Image.Clip>
            </Image>

            <Label Text="{Binding Nome}"
                   TextColor="Black"
                   FontSize="12"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation"
                   MaxLines="2"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding Empresa}"
                   FontSize="11"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding CustoPontosTexto}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#1F8A3B"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Border>
</ContentView>