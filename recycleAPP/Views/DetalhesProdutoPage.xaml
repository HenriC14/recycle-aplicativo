<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="recycleAPP.Views.DetalhesProdutoPage"
             BackgroundColor="#EAFBEF"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Button Text="Voltar"
                    Clicked="OnVoltarClicked"
                    BackgroundColor="#C9F4D4"
                    TextColor="Black"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    WidthRequest="120" />

            <Image x:Name="ImagemProduto"
                   Aspect="AspectFill"
                   HeightRequest="220"
                   HorizontalOptions="Center" />

            <Label x:Name="NomeLabel"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="EmpresaLabel"
                   FontSize="15"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3FBF63"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16"
                    HorizontalOptions="Center">
                <Label x:Name="CustoLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1F8A3B" />
            </Border>

            <Label Text="Detalhes completos do produto vao aparecer aqui (descricao, estoque, fotos adicionais etc.)"
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0" />

            <Button Text="Trocar por pontos"
                    Clicked="OnTrocarClicked"
                    BackgroundColor="#3FBF63"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    HeightRequest="48"
                    Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>