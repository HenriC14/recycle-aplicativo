<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="recycleAPP.Views.LoginColetorPage"
             BackgroundColor="#8FE3A6"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="120,Auto" Padding="24" RowSpacing="0">

            <Label Grid.Row="0"
                   Text="ReCycle"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1F8A3B"
                   VerticalOptions="End"
                   HorizontalOptions="Center"
                   Margin="0,0,0,24" />

            <Border Grid.Row="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="White"
                    Stroke="Transparent"
                    Padding="24,32">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Bem-vindo ao Recycle"
                           FontSize="22"
                           TextColor="Black"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Border StrokeShape="RoundRectangle 24"
                            BackgroundColor="#C9F4D4"
                            Stroke="Transparent"
                            Padding="16,4"
                            Margin="0,16,0,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#128100;" VerticalOptions="Center" FontSize="16" />
                            <Entry Grid.Column="1"
                                   x:Name="CpfEntry"
                                   TextColor="Black"
                                   Placeholder="CPF"
                                   Keyboard="Numeric"
                                   MaxLength="11"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="#2E2E2E" />
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 24"
                            BackgroundColor="#C9F4D4"
                            Stroke="Transparent"
                            Padding="16,4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#127970;" VerticalOptions="Center" FontSize="16" />
                            <Entry Grid.Column="1"
                                   x:Name="CnpjEntry"
                                   TextColor="Black"
                                   Placeholder="CNPJ da empresa"
                                   Keyboard="Numeric"
                                   MaxLength="14"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="#2E2E2E" />
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 24"
                            BackgroundColor="#C9F4D4"
                            Stroke="Transparent"
                            Padding="16,4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#128273;" VerticalOptions="Center" FontSize="16" />
                            <Entry Grid.Column="1"
                                   x:Name="PasswordEntry"
                                   TextColor="Black"
                                   Placeholder="Senha"
                                   IsPassword="True"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="#2E2E2E" />
                        </Grid>
                    </Border>

                    <Label x:Name="ErrorLabel"
                           TextColor="#D3302F"
                           FontSize="13"
                           HorizontalOptions="Center"
                           IsVisible="False" />

                    <Button Text="Entrar"
                            Clicked="OnEntrarClicked"
                            BackgroundColor="#3FBF63"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                    <Label Text="Esqueci minha senha"
                           FontSize="13"
                           TextColor="#1E90FF"
                           HorizontalOptions="Center"
                           Margin="0,4,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Nao tem uma conta?" TextColor="Black" FontSize="13" />
                        <Label Text="Crie uma agora!"
                               FontSize="13"
                               TextColor="#1E90FF"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreateAccountTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>