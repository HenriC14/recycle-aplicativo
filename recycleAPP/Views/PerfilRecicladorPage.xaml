<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:recycleAPP.Views.Controls"
             x:Class="recycleAPP.Views.PerfilRecicladorPage"
             BackgroundColor="#EAFBEF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Cabeçalho: foto, nome + etiqueta "Reciclador", engrenagem -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 30"
                        WidthRequest="90"
                        HeightRequest="90"
                        BackgroundColor="#C9F4D4"
                        Stroke="Transparent">
                        <Image x:Name="ImagemPerfil"
                           WidthRequest="90"
                           HeightRequest="90"
                           Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0" Spacing="2">
                        <Label TextColor="Black" x:Name="NomeLabel"
                           FontSize="18"
                           FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 10"
                            BackgroundColor="#3FBF63"
                            Stroke="Transparent"
                            Padding="8,2"
                            HorizontalOptions="Start">
                            <Label Text="Reciclador"
                               FontSize="11"
                               TextColor="White"
                               FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>

                    <Label TextColor="Black" Grid.Column="2"
                       Text="&#9881;"
                       FontSize="20"
                       VerticalOptions="Center" />
                </Grid>

                <!-- Seguidores / Seguindo -->
                <Grid ColumnDefinitions="*,*" Margin="72,0,0,0">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="seguidores" FontSize="12" TextColor="Gray" />
                        <Label TextColor="Black" x:Name="SeguidoresLabel" FontSize="16" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="seguindo" FontSize="12" TextColor="Gray" />
                        <Label TextColor="Black" x:Name="SeguindoLabel" FontSize="16" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>

                <Button x:Name="AcaoPerfilButton"
                    Text="Seguir"
                    Clicked="OnAcaoPerfilClicked"
                    BackgroundColor="#3FBF63"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="40" />

                <HorizontalStackLayout Spacing="6">
                    <Label TextColor="Black" Text="&#128205;" FontSize="14" />
                    <Label x:Name="EnderecoLabel"
                       FontSize="13"
                       TextColor="Gray"
                       LineBreakMode="WordWrap" />
                </HorizontalStackLayout>

                <!-- Última atividade -->
                <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3FBF63"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label TextColor="Black" Grid.Column="0" Text="Ultima atividade" FontAttributes="Bold" FontSize="15" />
                            <Label Grid.Column="1" x:Name="UltimaAtividadeQuandoLabel" TextColor="Gray" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                <Label TextColor="Black" Text="&#128092;" FontSize="22" HorizontalOptions="Center" />
                                <Label TextColor="Black" x:Name="UltimaAtividadePesoLabel" FontSize="13" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Image x:Name="UltimaAtividadeMaterialIcon" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label TextColor="Black" x:Name="UltimaAtividadeMaterialLabel" FontSize="13" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label TextColor="Black" Text="&#128694;" FontSize="22" HorizontalOptions="Center" />
                                <Label TextColor="Black" x:Name="UltimaAtividadeKmLabel" FontSize="13" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Quilos reciclados / Material mais reciclado -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#3FBF63"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="12">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label TextColor="Black" Text="Quilos reciclados" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            <Label TextColor="Black" Text="&#128092;" FontSize="26" HorizontalOptions="Center" />
                            <Label TextColor="Black" x:Name="QuilosRecicladosLabel" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#3FBF63"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="12">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label TextColor="Black" Text="Material mais reciclado" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            <Image x:Name="MaterialMaisRecicladoIcon" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" />
                            <Label TextColor="Black" x:Name="MaterialMaisRecicladoLabel" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Porcentagem Reciclada -->
                <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3FBF63"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,12">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="6">
                            <Label TextColor="Black" Text="&#128202;" FontSize="16" />
                            <Label TextColor="Black" Text="Porcentagem Reciclada" FontAttributes="Bold" FontSize="15" />
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                <Image Source="simbolo_plastico.png" WidthRequest="18" HeightRequest="18" />
                                <Label TextColor="Black" x:Name="PctPlasticoLabel" FontSize="14" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                <Image Source="simbolo_vidro.png" WidthRequest="18" HeightRequest="18" />
                                <Label TextColor="Black" x:Name="PctVidroLabel" FontSize="14" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                <Image Source="simbolo_metal.png" WidthRequest="18" HeightRequest="18" />
                                <Label TextColor="Black" x:Name="PctMetalLabel" FontSize="14" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Image Source="simbolo_papel.png" WidthRequest="18" HeightRequest="18" />
                                <Label TextColor="Black" x:Name="PctPapelLabel" FontSize="14" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>



            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>