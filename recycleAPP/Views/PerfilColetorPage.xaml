<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:recycleAPP.Views.Controls"
             x:Class="recycleAPP.Views.PerfilColetorPage"
             BackgroundColor="#EAFBEF"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 30"
                        WidthRequest="60"
                        HeightRequest="60"
                        BackgroundColor="#C9F4D4"
                        Stroke="Transparent">
                    <Label Text="&#128247;"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1"
                       x:Name="NomeLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="12,0,0,0" />

                <controls:SettingsMenu Grid.Column="2" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" Margin="72,0,0,0">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="seguidores" FontSize="12" TextColor="Gray" />
                    <Label x:Name="SeguidoresLabel" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="seguindo" FontSize="12" TextColor="Gray" />
                    <Label x:Name="SeguindoLabel" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>

            <Button x:Name="AcaoPerfilButton"
                Text="Seguir"
                Clicked="OnAcaoPerfilClicked"
                BackgroundColor="#3FBF63"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="20"
                HeightRequest="40" />

            <HorizontalStackLayout Spacing="6">
                <Label Text="&#128205;" FontSize="14" />
                <Label x:Name="EnderecoLabel"
                       FontSize="13"
                       TextColor="Gray"
                       LineBreakMode="WordWrap" />
            </HorizontalStackLayout>

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3FBF63"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Ultima atividade" FontAttributes="Bold" FontSize="15" />
                        <Label Grid.Column="1" x:Name="UltimaAtividadeQuandoLabel" TextColor="Gray" FontSize="13" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="&#128092;" FontSize="22" HorizontalOptions="Center" />
                            <Label x:Name="UltimaAtividadePesoLabel" FontSize="13" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="&#9851;" FontSize="22" HorizontalOptions="Center" />
                            <Label x:Name="UltimaAtividadeMaterialLabel" FontSize="13" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="&#128694;" FontSize="22" HorizontalOptions="Center" />
                            <Label x:Name="UltimaAtividadeKmLabel" FontSize="13" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#3FBF63"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="12">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Quilos reciclados" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="&#128092;" FontSize="26" HorizontalOptions="Center" />
                        <Label x:Name="QuilosRecicladosLabel" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#3FBF63"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="12">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Material mais reciclado" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="&#127863;" FontSize="26" HorizontalOptions="Center" />
                        <Label x:Name="MaterialMaisRecicladoLabel" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3FBF63"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,12">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="&#128202;" FontSize="16" />
                        <Label Text="Porcentagem Reciclada" FontAttributes="Bold" FontSize="15" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="&#127863;" FontSize="16" />
                            <Label x:Name="PctPlasticoLabel" FontSize="14" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="&#127871;" FontSize="16" />
                            <Label x:Name="PctVidroLabel" FontSize="14" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                            <Label Text="&#9875;" FontSize="16" />
                            <Label x:Name="PctMetalLabel" FontSize="14" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="&#128196;" FontSize="16" />
                            <Label x:Name="PctPapelLabel" FontSize="14" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>