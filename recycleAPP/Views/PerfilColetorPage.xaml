<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:recycleAPP.Views.Controls"
             x:Class="recycleAPP.Views.PerfilColetorPage"
             BackgroundColor="#EAFBEF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="14">

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                             StrokeShape="RoundRectangle 30"
                             WidthRequest="90"
                             HeightRequest="90"
                             BackgroundColor="#C9F4D4"
                             Stroke="Transparent">
                        <Image x:Name="ImagemPerfil"
                             WidthRequest="90"
                             HeightRequest="90"
                             Aspect="AspectFill" />
                    </Border>

                    <Label Grid.Column="1"
                       x:Name="NomeLabel"
                       TextColor="Black"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="12,0,0,0" />

                    <controls:SettingsMenu Grid.Column="2" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Margin="72,0,0,0">
                    <Label Text="seguidores" FontSize="12" TextColor="Gray" />
                    <Label x:Name="SeguidoresLabel" TextColor="Black" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                        x:Name="AcaoPerfilButton"
                        Text="Seguir"
                        Clicked="OnAcaoPerfilClicked"
                        BackgroundColor="#3FBF63"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="40" />
                    <Border Grid.Column="1"
                        x:Name="NovaReciclagemBorder"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#3FBF63"
                        Stroke="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        IsVisible="False">
                        <Label Text="&#10133;"
                           TextColor="White"
                           FontSize="16"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNovaReciclagemTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="0">
                    <Label x:Name="HorarioLabel"
                       TextColor="#1F8A3B"
                       FontAttributes="Bold"
                       FontSize="16" />
                    <Label x:Name="StatusAbertoLabel"
                       FontAttributes="Bold"
                       FontSize="14" />
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3FBF63"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Materiais que aceitamos"
                           TextColor="Black"
                           FontAttributes="Bold"
                           FontSize="15" />
                        <FlexLayout x:Name="MateriaisFlexLayout"
                                Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="Start" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="6">
                    <Label TextColor="Black" Text="&#128205;" FontSize="14" />
                    <Label x:Name="EnderecoLabel"
                       FontSize="13"
                       TextColor="Gray"
                       LineBreakMode="WordWrap" />
                </HorizontalStackLayout>

                <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3FBF63"
                    StrokeThickness="1"
                    BackgroundColor="#D9D9D9"
                    HeightRequest="150">
                    <Label Text="Mapa com a localizacao do ponto (em breve)"
                       TextColor="Black"
                       FontSize="12"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Padding="20" />
                </Border>

                <Button Text="Sair (logout)"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="#C9F4D4"
                    TextColor="Black"
                    CornerRadius="20"
                    HeightRequest="40"
                    Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar x:Name="BarraInferior" Grid.Row="1" />
    </Grid>

</ContentPage>