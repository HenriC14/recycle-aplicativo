<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:recycleAPP.Views.Controls"
             x:Class="recycleAPP.Views.PerfilColetorPage"
             BackgroundColor="#EAFBEF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- ================================== -->
        <!-- CONTEÚDO ORIGINAL DO PERFIL -->
        <!-- ================================== -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="20" Spacing="14">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 30"
                            WidthRequest="90"
                            HeightRequest="90"
                            BackgroundColor="#C9F4D4"
                            Stroke="Transparent">

                        <Image x:Name="ImagemPerfil"
                               WidthRequest="90"
                               HeightRequest="90"
                               Aspect="AspectFill" />
                    </Border>

                    <Label Grid.Column="1"
                           x:Name="NomeLabel"
                           TextColor="Black"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           Margin="12,0,0,0" />

                    <controls:SettingsMenu Grid.Column="2"
                                           VerticalOptions="Center" />

                </Grid>

                <VerticalStackLayout Margin="72,0,0,0">

                    <Label Text="seguidores"
                           FontSize="12"
                           TextColor="Gray" />

                    <Label x:Name="SeguidoresLabel"
                           TextColor="Black"
                           FontSize="16"
                           FontAttributes="Bold" />

                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">

                    <Button Grid.Column="0"
                            x:Name="AcaoPerfilButton"
                            Text="Seguir"
                            Clicked="OnAcaoPerfilClicked"
                            BackgroundColor="#3FBF63"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="20"
                            HeightRequest="40" />

                    <Border Grid.Column="1"
                            x:Name="NovaReciclagemBorder"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#3FBF63"
                            Stroke="Transparent"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            IsVisible="False">

                        <Label Text="&#10133;"
                               TextColor="White"
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnNovaReciclagemTapped" />
                        </Border.GestureRecognizers>

                    </Border>

                </Grid>

                <VerticalStackLayout Spacing="0">

                    <Label x:Name="HorarioLabel"
                           TextColor="#1F8A3B"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label x:Name="StatusAbertoLabel"
                           FontAttributes="Bold"
                           FontSize="14" />

                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#3FBF63"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="16,12">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Materiais que aceitamos"
                               TextColor="Black"
                               FontAttributes="Bold"
                               FontSize="15" />

                        <FlexLayout x:Name="MateriaisFlexLayout"
                                    Direction="Row"
                                    Wrap="Wrap"
                                    JustifyContent="Start" />

                    </VerticalStackLayout>

                </Border>

                <HorizontalStackLayout Spacing="6">

                    <Label TextColor="Black"
                           Text="&#128205;"
                           FontSize="14" />

                    <Label x:Name="EnderecoLabel"
                           FontSize="13"
                           TextColor="Gray"
                           LineBreakMode="WordWrap" />

                </HorizontalStackLayout>

                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#3FBF63"
                        StrokeThickness="1"
                        BackgroundColor="#D9D9D9"
                        HeightRequest="150">

                    <Label Text="Mapa com a localizacao do ponto (em breve)"
                           TextColor="Black"
                           FontSize="12"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Padding="20" />

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- ================================== -->
        <!-- BARRA INFERIOR -->
        <!-- ================================== -->

        <controls:BottomNavBar x:Name="BarraInferior"
                               Grid.Row="1" />

        <!-- ================================== -->
        <!-- NOTIFICAÇÃO SOBREPOSTA -->
        <!-- ================================== -->

        <Grid x:Name="NotificacaoOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              ZIndex="100"
              BackgroundColor="#99000000"
              Padding="14">

            <Border BackgroundColor="#EAFBEF"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 20"
                    Padding="14"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="420"
                    MaximumHeightRequest="720">

                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="10">

                    <!-- CABEÇALHO -->

                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="2">

                            <Label Text="Solicitações de reciclagem"
                                   TextColor="Black"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label x:Name="NotificacaoQuantidadeLabel"
                                   TextColor="#555555"
                                   FontSize="12" />

                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="✕"
                                FontSize="18"
                                WidthRequest="38"
                                HeightRequest="38"
                                Padding="0"
                                CornerRadius="19"
                                BackgroundColor="#D9D9D9"
                                TextColor="Black"
                                Clicked="OnFecharNotificacoesClicked" />

                    </Grid>

                    <!-- LISTA DE SOLICITAÇÕES -->

                    <ScrollView Grid.Row="1">

                        <VerticalStackLayout x:Name="SolicitacoesStack"
                                             Spacing="12" />

                    </ScrollView>

                    <!-- RODAPÉ -->

                    <Label Grid.Row="2"
                           Text="Confira os dados de cada solicitação."
                           TextColor="#666666"
                           FontSize="11"
                           HorizontalTextAlignment="Center" />

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
